#=======================================================================
#                  SavaPage OAuth Client Plug-in
# 
#                             Keycloak 
# 
#                    https://www.keycloak.org
#
#=======================================================================
#
#           THIS FILE CONTAINS CONFIDENTIAL INFORMATION AND
#              SHOULD ONLY BE ACCESSIBLE BY ADMINISTRATORS
#
#            DO NOT CHANGE THE PERMISSIONS SET ON THIS FILE
#
#=======================================================================

#-----------------------------------------------------------------
# Unique ID of this plug-in.
#-----------------------------------------------------------------
savapage.plugin.id=keycloak-oauth

#-----------------------------------------------------------------
# Descriptive name
#-----------------------------------------------------------------
savapage.plugin.name=Keycloak OAuth

#-----------------------------------------------------------------
# Plug-in class
#-----------------------------------------------------------------
savapage.plugin.class=org.savapage.ext.oauth.KeycloakOAuthPlugin

#-----------------------------------------------------------------
# true | false
#-----------------------------------------------------------------
#savapage.plugin.enable=false
savapage.plugin.enable=true

#-----------------------------------------------------------------
# Is plug-in turned online when loaded? (true | false) 
#
# When the plug-in is turned offline, users are not able to   
# authenticate, but Web API callbacks are handled. 
#-----------------------------------------------------------------
savapage.plugin.online=true

#-----------------------------------------------------------------
# true | false
#-----------------------------------------------------------------
savapage.plugin.live=true

#-------------------------------------------------------------------
# true | false (default)
#
# If "true", the OAuth provided User ID is part of SavaPage 
# external user source (OpenLDAP).
#
# This value is used to decide if an enabled "On demand user creation"
# "At first login" must be applied. If so, if a user is not present in 
# SavaPage after a successful OAuth login, the user is ad hoc created
# in anticipation of the next user sync.
#-------------------------------------------------------------------
#keycloak.savapage.usersource=true

#-------------------------------------------------------------------
# Optional custom icon path relative to "server/custom/web/" 
# without leading '/'.
#-------------------------------------------------------------------
#keycloak.plugin.icon=my_keycloak.png

#-----------------------------------------------------------
# Show icon in login button? true (default) | false
#-----------------------------------------------------------
#keycloak.login.btn.icon=false

#-----------------------------------------------------------
# Add text to login button (default: no text added)
#-----------------------------------------------------------
#keycloak.login.btn.text=Button text

#-----------------------------------------------------------------
# OAuth 2.0 client id and secret, baseURL and realm.
#-----------------------------------------------------------------
keycloak.oauth.client-id=your_client_id
keycloak.oauth.client-secret=your_client_secret
keycloak.oauth.base-url=your_base_url
keycloak.oauth.realm=your_realm

#-------------------------------------------
# realm path: 'realms' (default) or 
# 'auth/realms' for older Keycloak versions 
#-------------------------------------------
#keycloak.oauth.realm.path=realms
#keycloak.oauth.realm.path=auth/realms

#-----------------------------------------------------------------
# Authorized redirect URL: must end with /user?sp-oauth=keycloak
#-----------------------------------------------------------------
keycloak.oauth.callback-url=https://savapage.example.com/user?sp-oauth=keycloak

# end-of-file